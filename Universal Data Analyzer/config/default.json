{
  "analysis_rules": {
    "missing_value_threshold": 0.5,
    "outlier_method": "iqr",
    "correlation_threshold": 0.7,
    "numeric_bins": 30,
    "sample_size": 10000
  },
  "visualization": {
    "default_theme": "plotly",
    "color_palette": "viridis",
    "figure_width": 1200,
    "figure_height": 600
  },
  "reporting": {
    "include_summary": true,
    "include_distributions": true,
    "include_correlations": true,
    "page_size": "A4"
  },
  "database": {
    "default_db": "sqlite",
    "sqlite": {
      "connection_string": "sqlite:///data_analysis.db"
    },
    "postgresql": {
      "connection_string": "postgresql://user:password@localhost:5432/data_analysis"
    }
  },
  "logging": {
    "log_level": "INFO",
    "log_file": "data_analysis.log"
  }
}
